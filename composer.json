{
    "name": "kreativsoehne/sulu-email-obfuscator-bundle",
    "description": "Delivers e-mail addresses obfuscated on Sulu websites: ROT13 in the source, readable in the browser. Works on everything Sulu renders, without touching a template.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "sulu",
        "symfony",
        "email",
        "e-mail",
        "obfuscation",
        "spam",
        "harvester",
        "rot13"
    ],
    "authors": [
        {
            "name": "Kreativ&Söhne GmbH",
            "homepage": "https://www.kreativundsoehne.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.40",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.0",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0"
    },
    "suggest": {
        "sulu/sulu": "Registers the response listener in the website context only, so the administration interface stays untouched."
    },
    "autoload": {
        "psr-4": {
            "KreativSoehne\\SuluEmailObfuscatorBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KreativSoehne\\SuluEmailObfuscatorBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "fix": [
            "@php vendor/bin/rector process",
            "@php vendor/bin/php-cs-fixer fix"
        ],
        "lint": [
            "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
            "@php vendor/bin/phpstan analyse",
            "@php vendor/bin/rector process --dry-run"
        ],
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
